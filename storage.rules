rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /escritorios/{userId}/{allPaths=**} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                  && request.resource.size <= 4 * 1024 * 1024
                  && request.resource.contentType in [
                      'application/pdf',
                      'image/png',
                      'image/jpeg'
                  ];
    }
  }
}